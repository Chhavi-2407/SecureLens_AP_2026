generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String

  scanNotifications Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects Project[]
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  repository  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scans Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scan {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status ScanStatus @default(PENDING)

  language      String?
  securityScore Float?

  startedAt   DateTime?
  completedAt DateTime?

  files    File[]
  findings Finding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id String @id @default(uuid())

  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  path     String
  language String?
  size     Int?

  findings Finding[]

  createdAt DateTime @default(now())
}

model Finding {
  id String @id @default(uuid())

  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  type       String
  severity   String
  confidence Float

  cwe String?

  lineStart Int?
  lineEnd   Int?

  message        String
  recommendation String?

  createdAt DateTime @default(now())
}
